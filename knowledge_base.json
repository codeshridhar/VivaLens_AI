{
  "meta": {
    "project": "VivaLens AI",
    "version": "1.0",
    "author": "VivaLens AI Team",
    "description": "First-Order Logic style knowledge base for viva answer evaluation across 5 CS/AI topics.",
    "scoring_scale": "0-10",
    "global_filler_words": [
      "um", "uh", "like", "basically", "actually",
      "you know", "sort of", "kind of", "I guess",
      "I mean", "well", "so yeah", "right", "obviously"
    ],
    "global_rules": [
      {
        "rule_id": "GR01_MIN_LENGTH",
        "description": "∀x (Answer(x) ∧ WordCount(x) < 15) → TooShort(x)",
        "type": "length_check",
        "condition": "word_count < 15",
        "penalty": -2.0,
        "reason": "Answer is too brief to demonstrate understanding."
      },
      {
        "rule_id": "GR02_GOOD_LENGTH",
        "description": "∀x (Answer(x) ∧ WordCount(x) ≥ 40 ∧ WordCount(x) ≤ 200) → AdequateLength(x)",
        "type": "length_check",
        "condition": "40 <= word_count <= 200",
        "bonus": 0.5,
        "reason": "Answer length is appropriate for a viva response."
      },
      {
        "rule_id": "GR03_EXCESSIVE_LENGTH",
        "description": "∀x (Answer(x) ∧ WordCount(x) > 300) → Rambling(x)",
        "type": "length_check",
        "condition": "word_count > 300",
        "penalty": -0.5,
        "reason": "Answer is excessively long; may indicate lack of focus."
      },
      {
        "rule_id": "GR04_FILLER_PENALTY_LOW",
        "description": "∀x (Answer(x) ∧ FillerCount(x) ≥ 3 ∧ FillerCount(x) ≤ 5) → ModerateFillers(x)",
        "type": "filler_penalty",
        "condition": "3 <= filler_count <= 5",
        "penalty": -0.5,
        "reason": "Moderate use of filler words reduces clarity."
      },
      {
        "rule_id": "GR05_FILLER_PENALTY_HIGH",
        "description": "∀x (Answer(x) ∧ FillerCount(x) > 5) → ExcessiveFillers(x)",
        "type": "filler_penalty",
        "condition": "filler_count > 5",
        "penalty": -1.5,
        "reason": "Excessive filler words severely reduce answer quality."
      },
      {
        "rule_id": "GR06_NO_FILLERS_BONUS",
        "description": "∀x (Answer(x) ∧ FillerCount(x) == 0 ∧ WordCount(x) ≥ 20) → CleanSpeech(x)",
        "type": "filler_penalty",
        "condition": "filler_count == 0 and word_count >= 20",
        "bonus": 0.5,
        "reason": "No filler words detected; indicates confident delivery."
      },
      {
        "rule_id": "GR07_STRUCTURE_BONUS",
        "description": "∀x (Answer(x) ∧ HasStructureMarkers(x)) → WellStructured(x)",
        "type": "structure",
        "condition": "contains_structure_markers",
        "bonus": 0.5,
        "reason": "Answer uses structural markers (firstly, secondly, in conclusion) showing organized thought.",
        "structure_markers": [
          "first", "firstly", "second", "secondly", "third",
          "thirdly", "finally", "in conclusion", "to summarize",
          "on the other hand", "moreover", "furthermore",
          "for example", "for instance", "in contrast"
        ]
      }
    ]
  },

